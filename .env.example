# Скопируйте этот файл в .env и поменяйте значения перед запуском

# Порт локального сервера
PORT=3000

# Логин и пароль для входа в админ-панель (/admin)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=procode2025

# Секрет для подписи cookie-сессии администратора.
# Обязательно замените на случайную строку, иначе после каждого перезапуска
# сервера придётся входить в админку заново.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Часовой пояс, в котором сервер считает «сегодня», «эту неделю» и «этот месяц»:
# от него зависят дашборд, подсветка текущего дня в расписании и периоды начислений.
# VPS и Docker обычно работают в UTC — без этой строки отчёты сместятся на три часа.
# Имя пояса из базы IANA, например Europe/Moscow, Asia/Yekaterinburg, UTC.
TZ=Europe/Moscow

# Где лежат данные: sqlite (по умолчанию) или json.
# sqlite — одна база data/app.sqlite, изменения по нескольким коллекциям сохраняются
# целиком или не сохраняются вовсе. json — прежние файлы data/*.json; запасной вариант,
# если на сервере не собирается нативный драйвер better-sqlite3.
DATABASE_ENGINE=sqlite

# Файл базы SQLite. Относительный путь считается от корня проекта.
SQLITE_STORAGE=data/app.sqlite

# Ставьте 1, только если сайт работает за обратным прокси (nginx, Caddy).
# Иначе клиент сможет подделать заголовок X-Forwarded-For и обойти ограничения по IP.
TRUST_PROXY=0
