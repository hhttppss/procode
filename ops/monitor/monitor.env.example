# Шаблон конфига монитора. На сервере хранится как /opt/monitoring/monitor.env
# с правами 600 у пользователя procode-monitor — этот файл в git не попадает
# (см. .gitignore) и в чат отправлять его заполненную копию не нужно.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Пороги — можно менять без правки check.sh
MEM_AVAIL_MB_MIN=200
DISK_PCT_MAX=85
LOAD_MULT=1.5
SYNRECV_MAX=30
RECOVERY_STREAK=3
HEALTHZ_URL=http://127.0.0.1:3000/healthz
